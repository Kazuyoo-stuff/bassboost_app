<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.kazuyoo.bassboost">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="BassBoost"
        android:allowBackup="false"
        android:persistent="true">

        <!-- No activity = no icon di launcher -->

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Exported so "am startservice" works from adb without root. The DUMP permission is
          held by the adb shell (and root) but not by normal apps, so other apps cannot
          control the service.
        -->
        <service
            android:name=".BassService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse"
            android:persistent="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="audio effect" />
        </service>

    </application>

</manifest>
